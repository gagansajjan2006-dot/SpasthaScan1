# DocuCheck AI Configuration
PORT=8000
HOST=127.0.0.1

# Optional Vision AI model integration (e.g. Gemini, OpenAI, etc.)
# If left empty, DocuCheck AI uses its high-accuracy local Computer Vision pipeline
GEMINI_API_KEY=
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=25
ENABLE_INSPECTION_HISTORY=true

# Multilingual OCR language packs (Task E2)
# Comma-separated Tesseract lang codes, e.g. eng+hin+kan
# Requires: choco install tesseract  (packs: tesseract-ocr-hin, tesseract-ocr-kan)
OCR_LANGS=eng+hin+kan
